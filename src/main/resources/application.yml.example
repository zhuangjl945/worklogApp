# 配置模板：复制为 src/main/resources/application.yml 后按注释填写。
# 真实密钥不要提交到仓库（.gitignore 已忽略 application.yml）。

server:
  port: 8080
  # 经 Nginx 反代后仍要拿到真实来访 IP（手机端登记接口按 IP 限流依赖它）
  forward-headers-strategy: framework

spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/work_log_system?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8&connectTimeout=5000&socketTimeout=30000
    username: ${MYSQL_PROD_USER:}
    password: ${MYSQL_PROD_PASS:}
    driver-class-name: com.mysql.cj.jdbc.Driver
    hikari:
      connection-timeout: 8000
      maximum-pool-size: 10

  servlet:
    multipart:
      # 手机端拍照的服务端兜底上传限制（主路径是 OSS 直传）
      max-file-size: 5MB
      max-request-size: 30MB

mybatis:
  mapper-locations: classpath:mapper/*.xml
  configuration:
    map-underscore-to-camel-case: true

# JWT。密钥不合格应用会拒绝启动（JwtProps 启动期校验），这是有意的。
# 生成强随机密钥：
#   PowerShell : -join ((48..57)+(97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})
#   Linux/macOS: openssl rand -base64 48
jwt:
  secret: ${JWT_SECRET:}
  expire-seconds: 28800

# 跨域来源，逗号分隔。留空=只允许同源部署（推荐）。
# 只有手机端 H5 或管理端被单独部署到别的域名时才需要配置。
cors:
  allowed-origins: ${CORS_ALLOWED_ORIGINS:}

# 阿里云 OSS：AccessKey 只走环境变量，不写进文件
aliyun:
  oss:
    endpoint: oss-cn-hangzhou.aliyuncs.com
    bucket: your-bucket-name
    access-key-id: ${ALIYUN_OSS_ACCESS_KEY_ID:}
    access-key-secret: ${ALIYUN_OSS_ACCESS_KEY_SECRET:}
    dir-prefix: work-records/

# 需要设置的环境变量清单（启动前检查）：
#   JWT_SECRET               必填，>=32 字符
#   MYSQL_PROD_USER/PASS     必填
#   ALIYUN_OSS_ACCESS_KEY_ID/SECRET  使用附件上传时必填

# 手机端问题登记的防刷阈值（内部员工场景，默认值已按同办公室共用出口 IP 放宽）
ticket:
  rate:
    ip-count: 8            # 单 IP 在窗口内允许的提交次数
    ip-window-seconds: 600 # 窗口长度
    channel-qpm: 60        # 单渠道每分钟提交上限
    phone-hour: 5          # 同一手机号每小时上限
