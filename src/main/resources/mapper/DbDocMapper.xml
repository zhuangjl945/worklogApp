<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.zjl.worklog.dbdoc.mapper.DbDocMapper">

    <resultMap id="DbDocEntityMap" type="com.zjl.worklog.dbdoc.entity.DbDocEntity">
        <id column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="source_sql" property="sourceSql"/>
        <result column="parsed_json" property="parsedJson"/>
        <result column="table_count" property="tableCount"/>
        <result column="created_by" property="createdBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 插入文档记录 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO db_doc (title, source_sql, parsed_json, table_count, created_by)
        VALUES (#{title}, #{sourceSql}, #{parsedJson}, #{tableCount}, #{createdBy})
    </insert>

    <!-- 按 ID 查询 -->
    <select id="selectById" resultMap="DbDocEntityMap">
        SELECT id, title, source_sql, parsed_json, table_count,
               created_by, create_time, update_time
        FROM db_doc
        WHERE id = #{id}
        LIMIT 1
    </select>

    <!-- 分页查询，按创建时间倒序 -->
    <select id="selectPage" resultMap="DbDocEntityMap">
        SELECT id, title, source_sql, parsed_json, table_count,
               created_by, create_time, update_time
        FROM db_doc
        <where>
            <if test="keyword != null and keyword != ''">
                AND title LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
        ORDER BY create_time DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- 按关键字统计总数 -->
    <select id="countByKeyword" resultType="int">
        SELECT COUNT(*)
        FROM db_doc
        <where>
            <if test="keyword != null and keyword != ''">
                AND title LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
    </select>

    <!-- 按 ID 删除 -->
    <delete id="deleteById">
        DELETE FROM db_doc WHERE id = #{id}
    </delete>

</mapper>
