<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.zjl.worklog.credential.mapper.CredentialMapper">

    <resultMap id="CredentialEntityMap" type="com.zjl.worklog.credential.entity.CredentialEntity">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="category" property="category"/>
        <result column="username" property="username"/>
        <result column="password_encrypted" property="passwordEncrypted"/>
        <result column="secret_key_encrypted" property="secretKeyEncrypted"/>
        <result column="url" property="url"/>
        <result column="tags" property="tags"/>
        <result column="remark" property="remark"/>
        <result column="expire_date" property="expireDate"/>
        <result column="created_by" property="createdBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 查询字段列表 -->
    <sql id="columns">
        id, name, category, username, password_encrypted, secret_key_encrypted,
        url, tags, remark, expire_date, created_by, create_time, update_time
    </sql>

    <!-- 分页和统计的公共过滤条件 -->
    <sql id="filterWhere">
        <where>
            <if test="keyword != null and keyword != ''">
                AND (name LIKE CONCAT('%', #{keyword}, '%')
                     OR username LIKE CONCAT('%', #{keyword}, '%')
                     OR url LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="category != null and category != ''">
                AND category = #{category}
            </if>
        </where>
    </sql>

    <!-- 新增凭据 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO credential (name, category, username, password_encrypted, secret_key_encrypted,
                                url, tags, remark, expire_date, created_by)
        VALUES (#{name}, #{category}, #{username}, #{passwordEncrypted}, #{secretKeyEncrypted},
                #{url}, #{tags}, #{remark}, #{expireDate}, #{createdBy})
    </insert>

    <!-- 根据 ID 查询 -->
    <select id="selectById" resultMap="CredentialEntityMap">
        SELECT <include refid="columns"/>
        FROM credential
        WHERE id = #{id}
        LIMIT 1
    </select>

    <!-- 分页查询 -->
    <select id="selectPage" resultMap="CredentialEntityMap">
        SELECT <include refid="columns"/>
        FROM credential
        <include refid="filterWhere"/>
        ORDER BY create_time DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- 统计数量 -->
    <select id="countByFilter" resultType="int">
        SELECT COUNT(1)
        FROM credential
        <include refid="filterWhere"/>
    </select>

    <!-- 更新凭据 -->
    <update id="update">
        UPDATE credential
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="category != null">category = #{category},</if>
            <if test="username != null">username = #{username},</if>
            <if test="passwordEncrypted != null">password_encrypted = #{passwordEncrypted},</if>
            <if test="secretKeyEncrypted != null">secret_key_encrypted = #{secretKeyEncrypted},</if>
            <if test="url != null">url = #{url},</if>
            <if test="tags != null">tags = #{tags},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="expireDate != null">expire_date = #{expireDate},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 删除凭据 -->
    <delete id="deleteById">
        DELETE FROM credential
        WHERE id = #{id}
    </delete>

    <!-- 查询即将过期的凭据（expire_date 不为空，且在指定天数范围内） -->
    <select id="selectExpiringSoon" resultMap="CredentialEntityMap">
        SELECT <include refid="columns"/>
        FROM credential
        WHERE expire_date IS NOT NULL
          AND expire_date BETWEEN CURDATE() AND DATE_ADD(CURDATE(), INTERVAL #{days} DAY)
        ORDER BY expire_date ASC
    </select>

</mapper>
